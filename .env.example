# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env staat in .gitignore en hoort daar te blijven.

# --- SSH / WP-CLI -----------------------------------------------------------
# Host waar WordPress draait. Mag ook een alias uit je ~/.ssh/config zijn.
# Key-based auth is vereist: het script draait ssh met BatchMode=yes en faalt
# bewust meteen in plaats van om een wachtwoord te vragen en te blijven hangen.
SSH_TARGET=user@jouw-server.nl

# Pad naar de WordPress-installatie op de server (waar wp-config.php staat).
WP_PATH=/home/user/domains/staging/public_html

# Slug van de plugin die aan/uit gezet wordt.
PLUGIN_SLUG=flying-press

# --- Edge-cache purgen ------------------------------------------------------
# WP-CLI-commando dat de edge-cache leegt, zonder "wp" ervoor. Welk commando
# dat is verschilt per host; zie README.md ("Het purge-commando vinden").
#
# Op Rocket.net is dat "cdn purge" (Clear all cache for the website). Let op:
# "cache flush" is iets anders - dat leegt alleen de object-cache binnen
# WordPress en raakt de Cloudflare-edge niet aan.
#   PURGE_WP_COMMAND=cdn purge
#   PURGE_WP_COMMAND=eval 'do_action("jouw_host_purge_hook");'
#
# Laat je dit leeg, dan wordt er niet gepurged en waarschuwt het script. Bij
# edge-caching zijn je metingen dan waardeloos.
PURGE_WP_COMMAND=

# Wachttijd in ms na een purge voordat er warmgedraaid wordt. Verhoog dit als
# de preflight zegt dat de purge niet werkt, of als het rapport klaagt over
# wisselende cf-cache-status.
PURGE_SETTLE_MS=8000
